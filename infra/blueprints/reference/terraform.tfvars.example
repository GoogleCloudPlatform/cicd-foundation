# gcloud organizations describe $ORG_NAME --format="value(name.segment(1))"
org_id = 123456789012

folder_hub_id  = 123456789012
folder_prod_id = 123456789012
folder_test_id = 123456789012
folder_dev_id  = 123456789012

# projects_create = false

project_hub_host         = "prj-hub-host"
project_hub_supplychain  = "prj-hub-supplychain"
project_prod_host        = "prj-prod-host"
project_prod_supplychain = "prj-prod-supplychain"
project_prod_service     = "prj-prod-service"
project_test_host        = "prj-test-host"
project_test_supplychain = "prj-test-supplychain"
project_test_service     = "prj-test-service"
project_dev_host         = "prj-dev-host"
project_dev_supplychain  = "prj-dev-supplychain"
project_dev_service      = "prj-dev-service"

region     = "us-central1"
zone       = "us-central1-a"
ssm_region = "europe-west4"

# Leave github_owner / github_repo unset to provision Secure Source Manager (SSM) by default,
# or uncomment below to connect to an existing GitHub repository:
# github_owner = "GoogleCloudPlatform"
# github_repo  = "cicd-foundation"

developers = [
  "user:alex@example.com",
  "group:developers@example.com",
]

# Optional Kritis signer image reference:
# kritis_signer_image = "gcr.io/prj-prod-supplychain/kritis-signer@sha256:REPLACE_WITH_SHA256_OF_IMAGE"
