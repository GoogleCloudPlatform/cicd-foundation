[Unit]
Description=GNOME Remote Desktop RDP Server for %i
Requires=gnome-session@%i.service config-rendering.service
After=gnome-session@%i.service config-rendering.service
PartOf=gnome-session@%i.service

[Service]
Type=simple
User=%i
PAMName=systemd-user
EnvironmentFile=-/etc/systemd/system.conf.d/10-env.conf
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStartPre=/google/scripts/configure_rdp.sh %i
ExecStart=/usr/libexec/gnome-remote-desktop-daemon --headless
ExecStartPost=/google/scripts/wait_for_rdp_ready.sh %i
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target gnome-session@%i.service
