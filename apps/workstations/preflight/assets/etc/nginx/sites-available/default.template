# Content Negotiation: Map browser language to supported codes
map $http_accept_language $detected_lang {
    default "en";
    ~*^ar "ar";
    ~*^zh "zh";
    ~*^fr "fr";
    ~*^ru "ru";
    ~*^es "es";
}

# Protocol-agnostic WebSocket Upgrades
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    absolute_redirect off;
    root /var/www/html;

    # Security Headers
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Variables pre-calculated by config_rendering.sh
    set $backend_proxy_url ${BACKEND_PROXY_URL};
    set $cache_control_no_cache "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";

    # Redirect root to preflight dashboard or default protocol
    ${ROOT_REDIRECT_BLOCK}

    # Liveness probe: Is the Nginx proxy alive and accepting connections?
    location = /livez {
        add_header Cache-Control $cache_control_no_cache always;
        add_header Content-Type text/plain always;
        return 200 "OK";
    }

    # Readiness probe: Is the backend dynamically initialized and ready to accept traffic?
    location = /readyz {
        add_header Cache-Control $cache_control_no_cache always;
        add_header Content-Type text/plain always;

        # Backend readiness is strictly governed by the backend-readiness.service
        # which physically verifies socket bindings on 22, 3389, 4822, and 8080.
        if (!-f /run/backend_ready) {
            add_header App-Status "STARTING" always;
            return 503 "Backend Starting";
        }
        
        # When ready, intercept locally without blindly bouncing 404s off Tomcat
        add_header App-Status "READY" always;
        return 200 "OK";
    }

    # Config injection with server-side language detection
    location = /config.js {
        sub_filter '@@SERVER_LANG@@' '$detected_lang';
        sub_filter_once on;
        add_header Content-Type application/javascript always;
        add_header Cache-Control $cache_control_no_cache always;
    }

    # Manual start hook
    location = /start {
        return 302 ${ROOT_REDIRECT}?autoRedirect=false;
    }

    # Dedicated Licenses Route
    location = /licenses {
        return 302 ${ROOT_REDIRECT}#licenses;
    }

    # Preflight web dashboard static assets (HTML, JS, CSS, Fonts, Images, Locales, SBOM, Licenses)
    # Physical files in /var/www/html are served directly; all other routes fall back to backend proxy.
    location / {
        try_files $uri @backend_proxy;
        add_header Cache-Control $cache_control_no_cache always;
    }

    # Dedicated Guacamole backend proxy (APIs, Static Webapp, and WebSockets)
    location /guacamole/ {
        proxy_pass $backend_proxy_url$request_uri;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
        proxy_socket_keepalive on;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;

        # Transparent Auto-Login Injection
        set $auth_header "";
        if ($request_uri ~* "^/guacamole/api/tokens") {
            set $auth_header "Basic ${AUTH_HEADER}";
        }
        proxy_set_header Authorization $auth_header;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # Low-Latency Bidirectional Audio & Microphone Streamer
    location /audio/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
        proxy_socket_keepalive on;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    location @backend_proxy {
        proxy_intercept_errors ${PROXY_INTERCEPT_ON_OFF};
        ${ERROR_PAGE_DIRECTIVE}
        proxy_pass $backend_proxy_url$request_uri;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
        proxy_socket_keepalive on;

        # Standardize WebSockets + Proxy IP tracing across roots natively
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
    }
}
