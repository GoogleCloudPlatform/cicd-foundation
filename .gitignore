# ==========================================
# OS & Editor Templates
# ==========================================
# go/keep-sorted start
*.swp
*~
.DS_Store
.antigravity/
.history/
.idea/
.vscode/
antigravity
# go/keep-sorted end

# ==========================================
# Local Environments & Secrets
# ==========================================
# go/keep-sorted start
*secret*
.env
.env.local
.gemini/
.gitseep.yaml
# go/keep-sorted end

# ==========================================
# Infrastructure (Terraform)
# ==========================================
# go/keep-sorted start
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
.terraform/
# go/keep-sorted end

# ==========================================
# Python Development & Testing
# ==========================================
# go/keep-sorted start
*.pyc
*.pyo
.coverage
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
coverage.out
htmlcov/
# go/keep-sorted end

# ==========================================
# Node.js & Frontend Assets
# ==========================================
# go/keep-sorted start
.npm/
dist/
node_modules/
npm-debug.log
reports/
# go/keep-sorted end
